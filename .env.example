# Hindsight Cloud API and dedicated ShadowOps bank
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=shadowops-demo
HINDSIGHT_API_KEY=

# Optional Groq function-calling planner; rules-based planning is explicit if omitted
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Set to 1 only when intentionally running the live Cloud integration test
RUN_HINDSIGHT_CLOUD_E2E=0
